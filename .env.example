# --- Required -----------------------------------------------------------
# Supabase project (Settings → API). Use the Singapore region (ap-southeast-1).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key. Safe to expose: RLS protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Public URL of the deployed app (used for auth redirects).
NEXT_PUBLIC_SITE_URL=https://home.example.com

# --- Optional -----------------------------------------------------------
# Screenshot reading (suggested product name / price / dimensions). Leave blank to disable;
# manual entry always works. Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# --- Tests only (never set in Vercel) -----------------------------------
# From `npx supabase status` when running the local stack.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Path to the homeowners' workbook for the real-workbook import test (not committed).
WORKBOOK_PATH=
